# Importación de librerías base
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Configuración de estilo visual
sns.set_theme(style="whitegrid")
print("¡Librerías importadas correctamente!")

# Celda 2: Cargar el dataset de Bank Marketing
url = "https://archive.ics.uci.edu/ml/machine-learning-databases/00222/bank.zip"

# Como es un archivo .zip que contiene 'bank.csv', pandas lo lee directo usando un backend compatible
import urllib.request
import zipfile
import io

urllib.request.urlretrieve(url, "bank.zip")
with zipfile.ZipFile("bank.zip", "r") as z:
    # El archivo interno suele llamarse 'bank.csv' o 'bank-full.csv'
    filename = [f for f in z.namelist() if f.endswith('.csv')][0]
    with z.open(filename) as f:
        df = pd.read_csv(f, sep=';')

print(f"Dimensiones del dataset cargado: {df.shape}")
df.head()

# Celda 3: Limpieza y validación de calidad
import numpy as np
from sklearn.linear_model import LogisticRegression
import matplotlib.pyplot as plt
import seaborn as sns

# Fijamos semilla para reproducibilidad
np.random.seed(42)

# 1. Validaciones y exclusión estricta por data leakage ('duration' y 'y' original)
print("Valores nulos en el dataset:\n", df.isnull().sum())

if 'duration' in df.columns:
    df = df.drop(columns=['duration'])
if 'y' in df.columns:
    df = df.drop(columns=['y'])

# 2. Creación de un tratamiento sintético con solapamiento real (evita separación perfecta)
score_base = (df['balance'] - df['balance'].min()) / (df['balance'].max() - df['balance'].min()) + \
             (df['age'] / 100.0)

prob_treatment = 1 / (1 + np.exp(-3 * (score_base - score_base.median())))
df['synthetic_treatment'] = np.random.binomial(1, prob_treatment)

# 3. Preparación de covariables (X) y modelamiento del Propensity Score
X_features = pd.get_dummies(df.drop(columns=['synthetic_treatment'], errors='ignore'), drop_first=True)
T = df['synthetic_treatment']

ps_model = LogisticRegression(max_iter=1000)
ps_model.fit(X_features, T)

df['propensity_score'] = ps_model.predict_proba(X_features)[:, 1]

# 4. Gráfico corregido mostrando el solapamiento entre grupos
plt.figure(figsize=(10, 5))
sns.histplot(data=df, x='propensity_score', hue='synthetic_treatment', common_norm=False, bins=30, palette='Set2', alpha=0.6)
plt.title('Distribución Corregida del Propensity Score (Con Solapamiento Real)')
plt.xlabel('Propensity Score (Probabilidad de Tratamiento)')
plt.ylabel('Conteo')
plt.show()

# Celda 4: Estimación del Efecto Causal usando IPW (Inverse Probability Weighting)
import numpy as np

# Aseguramos que exista una variable de resultado (target) binaria para medir el impacto
if 'target' not in df.columns:
    np.random.seed(42)
    # Simulamos una tasa de conversión base del 12% afectada positivamente por el tratamiento
    df['target'] = np.random.binomial(1, 0.10 + 0.05 * df['synthetic_treatment'], size=len(df))

T = df['synthetic_treatment'].values
Y = df['target'].values
ps = df['propensity_score'].values

# Evitamos división por cero recortando ligeramente los propensity scores extremos (clipping)
ps = np.clip(ps, 0.01, 0.99)

# Cálculo del ATE mediante ponderación por probabilidad inversa (IPW)
mean_treated_ipw = np.sum(T * Y / ps) / np.sum(T / ps)
mean_control_ipw = np.sum((1 - T) * Y / (1 - ps)) / np.sum((1 - T) / (1 - ps))
ate = mean_treated_ipw - mean_control_ipw

print("="*40)
print(" RESULTADO DEL IMPACTO CAUSAL (IPW)")
print("="*40)
print(f"Efecto Promedio del Tratamiento (ATE): {ate:.4f}")
print(f"Conversión estimada en Tratados (Ponderada): {mean_treated_ipw:.4f}")
print(f"Conversión estimada en Control  (Ponderada): {mean_control_ipw:.4f}")
print("="*40)

# Celda 5: Simulación de Panel Longitudinal y Estimación de Diferencias en Diferencias (DiD)
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
import matplotlib.pyplot as plt
import seaborn as sns

np.random.seed(42)
n_individuals = 3000

# Creamos un panel de 2 periodos: 0 (Pre-intervención) y 1 (Post-intervención)
panel_data = []
for i in range(n_individuals):
    # Asignación aleatoria al grupo de tratamiento (50% tratados, 50% control)
    is_treated = np.random.binomial(1, 0.5)
    
    # Periodo Pre (t = 0): Saldo base del cliente
    balance_pre = np.random.normal(5000, 1200)
    panel_data.append({'client_id': i, 'period': 0, 'treated': is_treated, 'balance': balance_pre})
    
    # Periodo Post (t = 1): Crecimiento natural del mercado + Efecto real de la campaña CRM (solo para tratados)
    market_trend = np.random.normal(400, 150) # Crecimiento orgánico
    crm_effect = 950 if is_treated == 1 else 0 # Impacto causal puro del CRM
    balance_post = balance_pre + market_trend + crm_effect + np.random.normal(0, 100)
    panel_data.append({'client_id': i, 'period': 1, 'treated': is_treated, 'balance': balance_post})

df_did = pd.DataFrame(panel_data)

# Estimación del modelo econométrico de Diferencias en Diferencias vía OLS
# Formula: balance ~ treated + period + treated:period
# El coeficiente de la interacción (treated:period) es nuestro ATE / Efecto DiD exacto.
did_model = smf.ols('balance ~ treated + period + treated:period', data=df_did).fit()

print("="*50)
print(" RESULTADOS DEL MODELO ECONOMÉTRICO (DiD)")
print("="*50)
print(did_model.summary().tables[1])
print("="*50)
print(f"Efecto Causal Estimado del CRM (Interacción DiD): {did_model.params['treated:period']:.2f} soles/dólares")

# Gráfico de tendencias paralelas (idéntico al concepto de la pizarra)
plt.figure(figsize=(10, 5))
sns.lineplot(data=df_did, x='period', y='balance', hue='treated', marker='o', palette='Set1', errorbar=None)
plt.title('Validación de Tendencias Paralelas e Impacto DiD - Módulo CRM')
plt.xlabel('Periodo (0 = Pre-campaña, 1 = Post-campaña)')
plt.ylabel('Saldo Promedio')
plt.legend(title='Grupo', labels=['Control', 'Tratados'])
plt.xticks([0, 1], ['Pre-Campaña', 'Post-Campaña'])
plt.show()
